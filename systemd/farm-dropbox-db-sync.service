# /etc/systemd/system/farm-dropbox-db-sync.service
# FARM SERVICE
# Off-box Dropbox backup of the dbops database snapshots (/var/backups/data/databases).
# Install: sudo cp this to /etc/systemd/system/ then enable the .timer (not this).
[Unit]
Description=Off-box Dropbox backup of the database snapshots
After=network-online.target farm-db-backup.service
Wants=network-online.target

[Service]
Type=oneshot
User=gradywoodruff
Group=gradywoodruff
ExecStart=/srv/farm/sys/backups/rclone/databases-to-dropbox.sh
Nice=10
IOSchedulingClass=idle
# Queue wait is separate from the script's four-hour upload budget. The Redis
# snapshot is also bounded in the script; a queued run is not skipped.
TimeoutStartSec=infinity
