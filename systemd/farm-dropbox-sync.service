# FARM SERVICE
# One-way Dropbox backup of /srv/farm/production (read-only push; Syncthing-safe).
# Install: sudo cp this to /etc/systemd/system/ then enable the .timer (not this).

[Unit]
Description=One-way Dropbox backup of /srv/farm/production
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=gradywoodruff
Group=gradywoodruff
ExecStart=/srv/farm/sys/backups/rclone/production-to-dropbox.sh
Nice=10
IOSchedulingClass=idle
# Waiting for the shared upload lock must not consume the six-hour transfer
# budget. The script bounds rclone itself with GNU timeout after taking the lock.
TimeoutStartSec=infinity
